# ===================================================
# VARIÁVEIS DE AMBIENTE - PORTFÓLIO GABRIEL PEREIRA
# ===================================================

# 1. Banco de Dados Local (Desenvolvimento)
DATABASE_URL="file:../local.db"

# 2. Banco de Dados Turso (Produção / Vercel)
# Ao criar seu banco na Turso, preencha estas variáveis no painel da hospedagem:
TURSO_DATABASE_URL="libsql://[nome-do-seu-banco]-[seu-usuario].turso.io"
TURSO_AUTH_TOKEN="seu_token_gerado_no_turso_db_tokens_create"

# 3. Senha do Painel Administrativo (/admin)
# Defina uma senha forte para proteger o gerenciamento de projetos e stacks
ADMIN_PASSWORD=admin123

# 4. (Opcional) Token pessoal do GitHub para evitar limites de requisições da API pública
GITHUB_TOKEN=
